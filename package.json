{
  "name": "98tuber",
  "version": "1.0.0",
  "description": "YouTube proxy for Windows 98/IE6",
  "main": "viewer-server.js",
  "scripts": {
    "start": "node viewer-server.js",
    "dev": "node --watch viewer-server.js",
    "preview:layout": "node scripts/layout-preview-server.js",
    "preflight:media": "node scripts/media-preflight.js",
    "check": "node --check viewer-server.js && node --check youtube-client.js && node --check scripts/layout-preview-server.js && node --check scripts/media-preflight.js",
    "test": "npm run check && node --test"
  },
  "dependencies": {
    "dotenv": "^16.3.1",
    "ejs": "^3.1.10",
    "express": "^4.18.2",
    "googleapis": "^176.0.0",
    "jintr": "^3.3.1",
    "sharp": "^0.35.4",
    "youtubei.js": "18.0.0"
  },
  "overrides": {
    "tar": "^7.5.7",
    "qs": "^6.14.1"
  }
}
