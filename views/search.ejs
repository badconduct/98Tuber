<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
  <title>98Tuber - <%= heading %></title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <link rel="stylesheet" href="/base.css" type="text/css">
</head>
<body>
<div id="baseDiv">
  <%- include('header', { page: page, query: query }) %>

  <div class="section_title"><%= heading %></div>
  <% if (error) { %><div class="errorBox"><%= error %></div><% } %>

  <table width="100%" border="0" cellspacing="0" cellpadding="5">
    <% videos.forEach(function(video) { %>
    <tr>
      <td width="130" valign="top"><a href="/watch?v=<%= video.id %>"><img src="/thumbnail?url=<%= encodeURIComponent(video.thumbnail) %>" width="120" height="90" border="0" alt="" style="border: 1px solid #999"></a></td>
      <td valign="top">
        <a href="/watch?v=<%= video.id %>" class="video_title_large"><%= video.title %></a><br>
        <span class="video_meta"><%= video.description.substring(0, 180) %><%= video.description.length > 180 ? '...' : '' %></span><br><br>
        <table border="0" cellspacing="0" cellpadding="0">
          <tr><td class="video_meta" width="55">Time:</td><td class="video_meta"><b><%= video.duration %></b></td></tr>
          <tr><td class="video_meta">Added:</td><td class="video_meta"><%= video.publishedAt %></td></tr>
          <tr><td class="video_meta">From:</td><td class="video_meta"><a href="/search?q=<%= encodeURIComponent(video.channelTitle) %>"><%= video.channelTitle %></a></td></tr>
          <tr><td class="video_meta">Views:</td><td class="video_meta"><%= video.viewCount %></td></tr>
        </table>
      </td>
    </tr>
    <% }); %>
  </table>
  <% if (!videos.length && !error) { %><div class="contentBox">No videos found.</div><% } %>

  <div id="footerDiv"><div id="footerCopyright">98Tuber | <a href="/">Home</a> | <a href="/videos">Videos</a></div></div>
</div>
</body>
</html>
