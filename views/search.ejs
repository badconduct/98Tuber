<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
  <head>
    <title>98Tuber - Search: <%= query %></title>
    <link rel="stylesheet" type="text/css" href="/base.css" />
  </head>
  <body>
    <div align="center">
      <div id="main_container">
        <!-- Header -->
        <%- include('header') %>

        <br />

        <!-- Content -->
        <table width="100%" border="0" cellspacing="0" cellpadding="5">
          <tr>
            <td valign="top">
              <div class="section_title">Search Results for "<%= query %>"</div>
              <table width="100%" border="0" cellspacing="0" cellpadding="5">
                <% videos.forEach(function(video) { %>
                <tr>
                  <td width="130" valign="top">
                    <a href="/watch?v=<%= video.id %>">
                      <img
                        src="/thumbnail?url=<%= encodeURIComponent(video.snippet.thumbnails.default.url) %>"
                        width="120"
                        height="90"
                        border="0"
                      />
                    </a>
                  </td>
                  <td valign="top">
                    <a href="/watch?v=<%= video.id %>" class="video_title_large"
                      ><%= video.snippet.title %></a
                    >
                    <br />
                    <span class="video_meta">
                      <%= video.snippet.description.substring(0, 150) %>...
                    </span>
                    <br /><br />
                    <span class="video_details">
                      <table border="0" cellspacing="0" cellpadding="0">
                        <tr>
                          <td class="video_meta" style="padding-right: 10px">
                            Time:
                          </td>
                          <td class="video_meta">
                            <b><%= video.duration %></b>
                          </td>
                        </tr>
                        <tr>
                          <td class="video_meta" style="padding-right: 10px">
                            Added:
                          </td>
                          <td class="video_meta"><%= video.publishedAt %></td>
                        </tr>
                        <tr>
                          <td class="video_meta" style="padding-right: 10px">
                            From:
                          </td>
                          <td class="video_meta">
                            <a href="#"><%= video.snippet.channelTitle %></a>
                          </td>
                        </tr>
                        <tr>
                          <td class="video_meta" style="padding-right: 10px">
                            Views:
                          </td>
                          <td class="video_meta"><%= video.viewCount %></td>
                        </tr>
                        <tr>
                          <td class="video_meta" style="padding-right: 10px">
                            Ratings:
                          </td>
                          <td class="video_meta">
                            <img src="/images/star.gif" border="0" /><img
                              src="/images/star.gif"
                              border="0"
                            /><img src="/images/star.gif" border="0" /><img
                              src="/images/star.gif"
                              border="0"
                            /><img src="/images/star.gif" border="0" />
                          </td>
                        </tr>
                      </table>
                    </span>
                  </td>
                </tr>
                <% }); %>
              </table>
            </td>
          </tr>
        </table>

        <br />
        <div align="center" class="footer">&copy; 2025 98Tuber</div>
      </div>
    </div>
  </body>
</html>
