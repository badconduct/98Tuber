<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
  <title>YouTube - Broadcast Yourself.</title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <link rel="stylesheet" href="/base.css" type="text/css">
</head>
<body>
<div id="baseDiv">
  <%- include('header', { page: page, query: '' }) %>

  <% if (error) { %><div class="errorBox"><%= error %></div><% } %>

  <table width="790" align="center" cellpadding="0" cellspacing="0" border="0">
    <tr valign="top">
      <td width="595" style="padding-right: 15px">
        <table class="roundedTable" width="595" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFFFFF">
          <tr><td style="padding: 5px 10px 12px 10px">
            <div style="margin-bottom: 6px">
              <span style="font-size: 13px; color: #6d6d6d; font-weight: bold">Recently Featured</span>
              <span style="float: right; font-size: 11px"><a href="/videos">More Videos...</a></span>
            </div>
            <% if (recentlyFeatured.length) { %>
            <table width="100%" cellpadding="0" cellspacing="0" border="0"><tr>
              <% recentlyFeatured.forEach(function(video) { %>
              <td width="25%" align="center" valign="top">
                <a href="/watch?v=<%= video.id %>"><img src="/thumbnail?url=<%= encodeURIComponent(video.thumbnail) %>" width="80" height="60" border="0" alt="" style="border: 1px solid #999"></a>
                <div style="font-size: 10px; padding: 3px 4px 0 4px"><a href="/watch?v=<%= video.id %>"><%= video.title.substring(0, 24) %><%= video.title.length > 24 ? '...' : '' %></a></div>
              </td>
              <% }); %>
            </tr></table>
            <% } else if (!error) { %><div class="smallText">No featured videos were returned.</div><% } %>
          </td></tr>
        </table>

        <table class="roundedTable" width="595" cellpadding="0" cellspacing="0" border="0" bgcolor="#CCCCCC">
          <tr><td style="padding: 1px">
            <div class="sunkenTitleBar"><div class="sunkenTitle">
              <div style="float: right; padding-right: 5px; font-size: 12px"><a href="/videos">See More Videos</a></div>
              <span style="color: #444">Today's Featured Videos...</span>
            </div></div>
            <div style="background-color: #fff; padding: 5px">
              <% featuredVideos.forEach(function(video) { %>
              <div class="moduleEntry">
                <table width="565" cellpadding="0" cellspacing="0" border="0"><tr valign="top">
                  <td width="130"><a href="/watch?v=<%= video.id %>"><img src="/thumbnail?url=<%= encodeURIComponent(video.thumbnail) %>" class="moduleEntryThumb" width="120" height="90" border="0" alt=""></a></td>
                  <td>
                    <div class="moduleEntryTitle"><a href="/watch?v=<%= video.id %>"><%= video.title %></a></div>
                    <div class="moduleEntryDescription"><%= video.description.substring(0, 150) %><%= video.description.length > 150 ? '...' : '' %></div>
                    <div class="moduleEntryDetails">Added: <%= video.publishedAt %> by <a href="/search?q=<%= encodeURIComponent(video.channelTitle) %>"><%= video.channelTitle %></a></div>
                    <div class="moduleEntryDetails">Runtime: <%= video.duration %> | Views: <%= video.viewCount %></div>
                  </td>
                </tr></table>
              </div>
              <% }); %>
            </div>
          </td></tr>
        </table>
      </td>

      <td width="180">
        <table class="roundedTable" width="180" cellpadding="0" cellspacing="0" border="0" bgcolor="#FFEEBB">
          <tr><td style="padding: 8px">
            <div style="font-size: 14px; font-weight: bold; margin-bottom: 7px">Browse Videos</div>
            <div style="line-height: 20px">
              &raquo; <a href="/videos">Most Viewed</a><br>
              &raquo; <a href="/search?q=music">Music</a><br>
              &raquo; <a href="/search?q=comedy">Comedy</a><br>
              &raquo; <a href="/search?q=technology">Technology</a><br>
              &raquo; <a href="/search?q=film+animation">Film &amp; Animation</a>
            </div>
          </td></tr>
        </table>

        <table class="roundedTable" width="180" cellpadding="0" cellspacing="0" border="0" bgcolor="#EEEEEE" style="margin-top: 10px">
          <tr><td style="padding: 8px">
            <div style="font-size: 14px; font-weight: bold; margin-bottom: 7px">Active Channels</div>
            <% activeChannels.forEach(function(video) { %>
              <div class="hpChannelEntry">&raquo; <a href="/search?q=<%= encodeURIComponent(video.channelTitle) %>"><%= video.channelTitle %></a></div>
            <% }); %>
          </td></tr>
        </table>
      </td>
    </tr>
  </table>

  <div id="footerDiv"><div id="footerCopyright">98Tuber | <a href="/">Home</a> | <a href="/videos">Videos</a></div></div>
</div>
</body>
</html>
