<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
  <head>
    <title>98Tuber - Groups</title>
    <link rel="stylesheet" type="text/css" href="/base.css" />
  </head>
  <body>
    <div align="center">
      <div id="main_container">
        <!-- Header -->
        <%- include('header') %>

        <br />

        <div class="section_title">Groups (Playlists)</div>
        <div
          class="small_text"
          style="
            padding: 10px;
            background: #ffffcc;
            border: 1px solid #cccc99;
            margin-bottom: 10px;
          "
        >
          <b>Note:</b> YouTube Groups are deprecated. Showing Playlists instead.
        </div>

        <table width="100%" border="0" cellspacing="0" cellpadding="5">
          <% groups.forEach(function(group) { %>
          <tr>
            <td width="100" valign="top">
              <img
                src="<%= group.thumbnail %>"
                width="120"
                height="90"
                style="border: 1px solid #000"
              />
            </td>
            <td valign="top">
              <div class="video_title"><a href="#"><%= group.title %></a></div>
              <div class="small_text">By: <%= group.channelTitle %></div>
              <div class="small_text"><%= group.description %></div>
            </td>
          </tr>
          <tr>
            <td colspan="2" style="border-bottom: 1px dashed #cccccc"></td>
          </tr>
          <% }); %>
        </table>

        <br />
        <div align="center" class="footer">&copy; 2025 98Tuber</div>
      </div>
    </div>
  </body>
</html>
