<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
  <head>
    <title>98Tuber - Viewing History</title>
    <link rel="stylesheet" type="text/css" href="/base.css" />
  </head>
  <body>
    <div align="center">
      <div id="main_container">
        <!-- Header -->
        <%- include('header') %>

        <br />

        <!-- Content -->
        <table width="100%" border="0" cellspacing="0" cellpadding="5">
          <tr>
            <td valign="top">
              <div class="section_title">Viewing History</div>
              <div style="padding-bottom: 10px; color: #666; font-size: 11px">
                Videos you have watched this session (Last 10).
              </div>

              <% if (videos.length === 0) { %>
              <div align="center" style="padding: 20px">
                <b>No history available.</b><br />
                Start watching videos to populate this list!
              </div>
              <% } else { %>

              <table width="100%" border="0" cellspacing="0" cellpadding="5">
                <% videos.forEach(function(video) { %>
                <tr>
                  <td width="130" valign="top">
                    <a href="/watch?v=<%= video.id %>">
                      <img
                        src="<%= video.thumbnail %>"
                        width="120"
                        height="90"
                        border="0"
                        style="border: 1px solid #999"
                      />
                    </a>
                  </td>
                  <td valign="top">
                    <a href="/watch?v=<%= video.id %>" class="video_title_large"
                      ><%= video.title %></a
                    >
                    <br />
                    <span class="video_meta">
                      <%= video.description ? video.description.substring(0,
                      150) + (video.description.length > 150 ? '...' : '') : ''
                      %>
                    </span>
                    <br /><br />
                    <span class="video_details">
                      <table border="0" cellspacing="0" cellpadding="0">
                        <tr>
                          <td class="video_meta" style="padding-right: 10px">
                            Time:
                          </td>
                          <td class="video_meta">
                            <b><%= video.duration %></b>
                          </td>
                        </tr>
                        <tr>
                          <td class="video_meta" style="padding-right: 10px">
                            Added:
                          </td>
                          <td class="video_meta"><%= video.relativeDate %></td>
                        </tr>
                        <tr>
                          <td class="video_meta" style="padding-right: 10px">
                            From:
                          </td>
                          <td class="video_meta">
                            <a href="#"><%= video.channelTitle %></a>
                          </td>
                        </tr>
                        <tr>
                          <td class="video_meta" style="padding-right: 10px">
                            Views:
                          </td>
                          <td class="video_meta"><%= video.viewCount %></td>
                        </tr>
                      </table>
                    </span>
                  </td>
                </tr>
                <tr>
                  <td
                    colspan="2"
                    style="
                      border-bottom: 1px dashed #999;
                      height: 1px;
                      padding: 0;
                    "
                  ></td>
                </tr>
                <tr>
                  <td colspan="2" height="5"></td>
                </tr>
                <% }); %>
              </table>
              <% } %>
            </td>
          </tr>
        </table>

        <br />
        <div align="center" class="footer">&copy; 2025 98Tuber</div>
      </div>
    </div>
  </body>
</html>
