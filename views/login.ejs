<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
  <head>
    <title>YouTube - Log In</title>
    <link rel="stylesheet" type="text/css" href="/base.css" />
  </head>
  <body>
    <div align="center">
      <div id="main_container">
        <%- include('header') %>
        <br />

        <table
          width="100%"
          align="center"
          cellpadding="0"
          cellspacing="0"
          border="0"
        >
          <tr valign="top">
            <!-- Left Column: Join -->
            <td width="60%" style="padding-right: 10px">
              <div class="section_title">Join 98Tuber</div>
              <div style="padding: 5px">
                <b>What is 98Tuber?</b><br />
                98Tuber is a way to get your videos to the people who matter to
                you. With 98Tuber you can:
                <ul>
                  <li>Show off your favorite videos to the world</li>
                  <li>
                    Blog the videos you take with your digital camera or cell
                    phone
                  </li>
                  <li>
                    Securely and privately show videos to your friends and
                    family around the world
                  </li>
                  <li>... and much, much more!</li>
                </ul>
                <br />
                <a href="/signup"><b>Sign up now</b></a> and open a free
                account.
              </div>
            </td>

            <!-- Right Column: Login -->
            <td width="40%">
              <div class="section_title">Members Log In</div>
              <div
                style="
                  background-color: #eeeeee;
                  border: 1px solid #cccccc;
                  padding: 10px;
                "
              >
                <% if (typeof error !== 'undefined') { %>
                <div style="color: red; font-weight: bold; margin-bottom: 10px">
                  <%= error %>
                </div>
                <% } %>

                <form action="/login" method="post">
                  <table
                    border="0"
                    cellspacing="0"
                    cellpadding="2"
                    width="100%"
                  >
                    <tr>
                      <td align="right"><b>User Name:</b></td>
                      <td>
                        <input
                          type="text"
                          name="username"
                          size="20"
                          style="width: 150px"
                        />
                      </td>
                    </tr>
                    <tr>
                      <td align="right"><b>Password:</b></td>
                      <td>
                        <input
                          type="password"
                          name="password"
                          size="20"
                          style="width: 150px"
                        />
                      </td>
                    </tr>
                    <tr>
                      <td>&nbsp;</td>
                      <td>
                        <input
                          type="submit"
                          value="Log In"
                          style="font-weight: bold"
                        />
                      </td>
                    </tr>
                    <tr>
                      <td>&nbsp;</td>
                      <td style="font-size: 11px">
                        <a href="#">Forgot your password?</a>
                      </td>
                    </tr>
                  </table>
                </form>
              </div>
            </td>
          </tr>
        </table>

        <br /><br />
        <div align="center" class="footer">&copy; 2025 98Tuber</div>
      </div>
    </div>
  </body>
</html>
