<!DOCTYPE HTML PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
<head>
  <title>98Tuber<%= video ? ' - ' + video.title : '' %></title>
  <meta http-equiv="Content-Type" content="text/html; charset=utf-8">
  <link rel="stylesheet" href="/base.css" type="text/css">
  <% if (video) { %>
  <script type="text/javascript">
  var conversionTimer = null;
  function createRequest() {
    if (window.XMLHttpRequest) return new XMLHttpRequest();
    try { return new ActiveXObject("Msxml2.XMLHTTP"); } catch (e) {}
    try { return new ActiveXObject("Microsoft.XMLHTTP"); } catch (e) {}
    return null;
  }
  function showConversionMessage(message) {
    document.getElementById("conversion_message").innerHTML = message;
  }
  function pollConversion() {
    var request = createRequest();
    if (!request) { showConversionMessage("Your browser could not check conversion status. Reload this page in a few minutes."); return; }
    request.onreadystatechange = function() {
      if (request.readyState != 4) return;
      if (request.status == 200) {
        var status = request.responseText.replace(/^\s+|\s+$/g, "");
        if (status == "complete") { window.location.reload(); return; }
        if (status == "error" || status == "rejected") { showConversionMessage("Conversion failed or was rejected."); return; }
        showConversionMessage("Conversion in progress... please wait.");
        conversionTimer = window.setTimeout(pollConversion, 2500);
      } else {
        showConversionMessage("Unable to check conversion status.");
      }
    };
    request.open("GET", "/status/<%= videoId %>?t=" + new Date().getTime(), true);
    request.send(null);
  }
  function startConversion() {
    var request = createRequest();
    if (!request) return true;
    document.getElementById("start_conversion").style.display = "none";
    document.getElementById("conversion_progress").style.display = "block";
    showConversionMessage("Starting conversion...");
    request.onreadystatechange = function() {
      if (request.readyState != 4) return;
      if (request.status == 202 || request.status == 200) {
        conversionTimer = window.setTimeout(pollConversion, 1500);
      } else {
        showConversionMessage(request.responseText || "Unable to start conversion.");
      }
    };
    request.open("GET", "/stream/<%= videoId %>", true);
    request.send(null);
    return false;
  }
  </script>
  <% } %>
</head>
<body>
<div id="baseDiv">
  <%- include('header', { page: page, query: '' }) %>

  <% if (error || !video) { %>
    <div class="errorBox"><%= error || 'Video was not found.' %></div>
  <% } else { %>
    <div style="font-size: 18px; font-weight: bold; color: #333; margin: 10px 0"><%= video.title %></div>
    <table width="875" cellpadding="0" cellspacing="0" border="0"><tr valign="top">
      <td width="450" style="padding-right: 15px">
        <div style="margin-bottom: 10px">
        <% if (isCached) { %>
          <object id="MediaPlayer" classid="CLSID:22D6F312-B0F6-11D0-94AB-0080C74C7E95" width="450" height="370">
            <param name="FileName" value="/cache/<%= videoId %>.mpg">
            <param name="AutoStart" value="true">
            <param name="ShowControls" value="true">
            <param name="ShowStatusBar" value="true">
            <embed type="application/x-mplayer2" src="/cache/<%= videoId %>.mpg" width="450" height="370" autostart="true"></embed>
          </object>
        <% } else if (convertible) { %>
          <div id="start_conversion" style="width: 450px; height: 370px; background: #000; color: #fff; text-align: center">
            <div style="padding-top: 145px">Video requires conversion.<br><br><a href="/stream/<%= videoId %>" onclick="return startConversion();" style="color: #ff0; font-weight: bold">[ Click here to Start Conversion ]</a></div>
          </div>
          <div id="conversion_progress" style="display: none; width: 450px; height: 370px; background: #000; color: #fff; text-align: center">
            <div style="padding-top: 155px"><b id="conversion_message">Starting conversion...</b><br><br><span class="smallText" style="color: #fff">This page will reload when the video is ready.</span></div>
          </div>
        <% } else { %>
          <div style="width: 450px; height: 370px; background: #000; color: #fff; text-align: center"><div style="padding-top: 155px">This video is longer than the <%= maxVideoMinutes %>-minute conversion limit.</div></div>
        <% } %>
        </div>
      </td>
      <td width="410">
        <div style="border: 1px solid #ccc; padding: 8px; margin-bottom: 10px">
          <div style="font-size: 11px; margin-bottom: 8px">Added: <b><%= video.publishedDate %></b><br>From: <a href="/search?q=<%= encodeURIComponent(video.channelTitle) %>"><b><%= video.channelTitle %></b></a></div>
          <div style="font-size: 12px; margin-bottom: 10px"><%= video.description %></div>
          <div style="font-size: 11px"><b>Runtime:</b> <%= video.duration %><br><b>Views:</b> <%= video.viewCount %></div>
          <div style="font-size: 11px; margin-top: 8px"><b>URL</b><br><input type="text" value="http://www.youtube.com/watch?v=<%= videoId %>" style="width: 375px; font-size: 10px"></div>
        </div>
        <div class="contentBox">
          <div class="headerTitleLite" style="margin-bottom: 6px">Find More Videos</div>
          <form method="get" action="/search"><input type="text" name="q" maxlength="128" style="width: 270px"> <input type="submit" value="Search"></form>
          <div style="padding-top: 8px"><a href="/videos">Browse most viewed videos</a></div>
        </div>
      </td>
    </tr></table>
  <% } %>

  <div id="footerDiv"><div id="footerCopyright">98Tuber | <a href="/">Home</a> | <a href="/videos">Videos</a></div></div>
</div>
</body>
</html>
