<div id="logoTagDiv">
  <a href="/"><img src="/images/youtube_logo.jpg" alt="YouTube" width="120" border="0"></a>
</div>

<div id="utilDiv">
  <a href="/">Home</a>
  <span class="utilDelim">|</span>
  <a href="/videos">Videos</a>
  <span class="utilDelim">|</span>
  <a href="/search?q=classic+television">Classic TV</a>
</div>

<div id="searchDiv">
  <form name="searchForm" id="searchForm" method="get" action="/search">
    <span class="smallLabel">Search for&nbsp;</span>
    <input tabindex="10000" type="text" name="q" maxlength="128" class="searchField" value="<%= typeof query !== 'undefined' ? query : '' %>">
    &nbsp;<input type="submit" value="Search">
  </form>
</div>

<table width="100%" cellpadding="0" cellspacing="0" border="0">
  <tr>
    <td>
      <div id="gNavDiv">
        <div class="tab"><div class="tabContent <%= page === 'home' ? 'selected' : '' %>"><a href="/">Home</a></div></div>
        <div class="tab"><div class="tabContent <%= page === 'videos' ? 'selected' : '' %>"><a href="/videos">Videos</a></div></div>
        <div class="tab"><div class="tabContent"><a href="/search?q=music">Music</a></div></div>
        <div class="tab"><div class="tabContent"><a href="/search?q=comedy">Comedy</a></div></div>
        <div class="tab"><div class="tabContent"><a href="/search?q=technology">Technology</a></div></div>
        <div class="tab"><div class="tabContent"><a href="/search?q=film+animation">Film &amp; Animation</a></div></div>
      </div>
    </td>
  </tr>
  <tr>
    <td>
      <div id="gSubNavDiv">
        <a href="/videos">Most Viewed</a>
        <span style="padding: 0px 8px">|</span>
        <a href="/search?q=gaming">Gaming</a>
        <span style="padding: 0px 8px">|</span>
        <a href="/search?q=news">News</a>
        <span style="padding: 0px 8px">|</span>
        <a href="/search?q=sports">Sports</a>
        <span style="padding: 0px 8px">|</span>
        <a href="/search?q=retro+computing">Retro Computing</a>
      </div>
    </td>
  </tr>
</table>
