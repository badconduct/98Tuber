<!DOCTYPE html PUBLIC "-//W3C//DTD HTML 4.01 Transitional//EN">
<html>
  <head>
    <title>98Tuber - Channels</title>
    <link rel="stylesheet" type="text/css" href="/base.css" />
  </head>
  <body>
    <div align="center">
      <div id="main_container">
        <!-- Header -->
        <%- include('header') %>

        <br />

        <div class="section_title">Popular Channels</div>
        <table width="100%" border="0" cellspacing="0" cellpadding="5">
          <% channels.forEach(function(channel) { %>
          <tr>
            <td width="100" valign="top">
              <img
                src="<%= channel.thumbnail %>"
                width="88"
                height="88"
                style="border: 1px solid #999"
              />
            </td>
            <td valign="top">
              <div class="video_title_large">
                <a href="#"><%= channel.title %></a>
              </div>
              <div class="small_text"><%= channel.description %></div>
              <br />
              <a href="#" class="small_text">[Subscribe]</a>
            </td>
          </tr>
          <tr>
            <td colspan="2" style="border-bottom: 1px dashed #cccccc"></td>
          </tr>
          <% }); %>
        </table>

        <br />
        <div align="center" class="footer">&copy; 2025 98Tuber</div>
      </div>
    </div>
  </body>
</html>
